// Hoe deze app op Cloudflare draait. `name` en het eigen domein zijn van dit project;
// de andere regels gelden voor elke app in de stack en worden gecontroleerd door
// scripts/lib/cloudflare-config.mjs (check guard:cloudflare). Alleen sleutels van de
// lijst daar mogen erin; opslag van Cloudflare (D1, R2, KV, Durable Objects) niet.
//
// Twee standen, zie docs/WERKWIJZE.md:
//   standaard  "workers_dev": false plus een route met "custom_domain": true (hieronder).
//   tijdelijk  "workers_dev": true en geen "routes", alleen zolang er nog geen eigen
//              domein is. De app staat dan op <name>.<subdomein>.workers.dev, achter
//              de Access op de Worker zelf. Is het domein er, dan terug naar standaard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-proef",
  "compatibility_date": "2026-09-01",
  // Alleen de gebouwde bestanden; een onbekend pad valt terug op index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Tijdelijke stand: nog geen eigen domein, dus alleen het workers.dev-adres, achter de
  // Access op de Worker zelf. Komt er een domein: false, plus de route hieronder terug.
  "workers_dev": true,
  // Previews per pull request. Access op de Worker zelf dekt ook deze adressen.
  "preview_urls": true
  // Standaardstand, zodra er een eigen domein is:
  // "routes": [{ "pattern": "<app>.<domein>", "custom_domain": true }]
}
