{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Streng vanaf regel één. Dit is de goedkoopste manier om agent-fouten
       mechanisch af te vangen; later aanzetten is veel duurder. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.rls.config.ts",
    "playwright.config.ts"
  ],
  /* supabase/functions draait op Deno, met andere globals en andere imports.
     Die map hoort NIET bij deze typecontrole. Zie CLAUDE.md. */
  "exclude": ["node_modules", "dist", "supabase/functions"]
}
