{
  "name": "stack-template",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard",
    "guard": "pnpm guard:tests && pnpm guard:migrations && pnpm guard:rls && pnpm guard:secrets && pnpm guard:escapes && pnpm guard:template",
    "guard:tests": "node scripts/guard-tests.mjs",
    "guard:migrations": "node scripts/guard-migrations.mjs",
    "guard:rls": "node scripts/guard-rls.mjs",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "guard:escapes": "node scripts/guard-escape-hatches.mjs",
    "guard:template": "node scripts/guard-template.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/write-db-types.mjs",
    "db:types:check": "node scripts/check-types-in-sync.mjs",
    "env:local": "node scripts/write-local-env.mjs",
    "env:test": "node scripts/write-test-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
